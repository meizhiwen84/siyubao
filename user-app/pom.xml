    <build>
        <resources>
            <!-- 1. 只对 application.yml 开启变量替换 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/application.yml</include>
                </includes>
            </resource>

            <!-- 2. 所有其他资源：原样复制，不修改、不损坏 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/application.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>

            <!-- 1. 先编译出原始 jar（不含依赖） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- 2. ProGuard 混淆 【只混淆你的代码，不碰框架】 -->
            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>
                <version>2.7.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>proguard</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <proguardVersion>7.4.2</proguardVersion>

                    <!-- 关键：只混淆原始 jar，不混淆 -boot.jar -->
                    <injar>${project.build.finalName}.jar</injar>
                    <outjar>${project.build.finalName}.jar</outjar>

                    <libs>
                        <lib>${java.home}/jmods/java.base.jmod</lib>
                        <lib>${java.home}/jmods/java.desktop.jmod</lib>
                        <lib>${java.home}/jmods/java.sql.jmod</lib>
                    </libs>

                    <options>
                        <option>-target 21</option>
                        <option>-dontpreverify</option>
<!--                        <option>-noverify</option>-->
                        <option>-allowaccessmodification</option>
                        <option>-useuniqueclassmembernames</option>
                        <option>-keeppackagenames</option>

                        <option>-dontshrink</option>
                        <option>-dontoptimize</option>

                        <!-- 打开代码混淆（控制流混淆）-->
                        <option>-optimize</option>
                        <option>-optimizations **</option>
                        <option>-mergeinterfacesaggressively</option>
                        <option>-overloadaggressively</option>
                        <option>-flattenpackagehierarchy</option>

                        <!-- 关键：禁用某些可能导致VerifyError的优化 -->
                        <option>-optimizations !code/allocation/variable,!method/marking/private,!field/removal/writeonly,!class/merging/*</option>

                        <!-- 绝对不混淆 Spring Boot Loader -->
                        <option>-keep class org.springframework.boot.loader.** { *; }</option>
                        <option>-keep interface org.springframework.boot.loader.** { *; }</option>

                        <!-- 你的主类 - 绝对不混淆，特别是main方法 -->
                        <option>-keep class cn.laobayou.siyubao.DesktopApp {
                            public static void main(java.lang.String[]);
                            *;
                        }</option>
                        <option>-keep class cn.laobayou.siyubao.SiyubaoApplication { *; }</option>
                        
                        <!-- 保留DesktopApp的内部类 -->
                        <option>-keep class cn.laobayou.siyubao.DesktopApp$* { *; }</option>

                        <!-- Spring 注解不混淆 -->
                        <option>-keep @org.springframework.stereotype.Component class * { *; }</option>
                        <option>-keep @org.springframework.stereotype.Controller class * { *; }</option>
                        <option>-keep @org.springframework.stereotype.Repository class * { *; }</option>
<!--                        <option>-keep @org.springframework.stereotype.* class * { *; }</option>-->

                        <option>-keep @org.springframework.web.bind.annotation.* class * { *; }</option>
                        <option>-keep @org.springframework.boot.autoconfigure.SpringBootApplication class * { *; }</option>
                        <option>-keep @javax.persistence.Entity class * { *; }</option>
                        <option>-keep @org.springframework.context.annotation.Configuration class * { *; }</option>

                        <!-- 注入字段不混淆 -->
                        <option>-keepclassmembers class * {
                            @org.springframework.beans.factory.annotation.Autowired *;
                            @org.springframework.beans.factory.annotation.Value *;
                            }</option>
                        <option>-keepclassmembers class * {
                            @org.springframework.web.bind.annotation.* *;
                            }</option>

                        <!-- 你的业务包不混淆 -->
                        <option>-keep class cn.laobayou.siyubao.bean.** { *; }</option>
                        <option>-keep class cn.laobayou.siyubao.bridge.** { *; }</option>
                        <option>-keep class cn.laobayou.siyubao.config.** { *; }</option>
                        <option>-keep class cn.laobayou.siyubao.desktop.** { *; }</option>
                        <option>-keep class cn.laobayou.siyubao.tools.** { *; }</option>
                        <option>-keep class cn.laobayou.siyubao.ui.** { *; }</option>
                        <option>-keep class cn.laobayou.siyubao.repository.** { *; }</option>

                        <!-- 第三方依赖不混淆 -->
                        <option>-keep class org.cef.** { *; }</option>
                        <option>-keep class com.sun.jna.** { *; }</option>
                        <option>-keep class liquibase.** { *; }</option>
                        <option>-keep class org.sqlite.** { *; }</option>
                        <option>-keep class com.fasterxml.** { *; }</option>
                        <option>-keep class com.google.gson.** { *; }</option>

                        <!-- 忽略警告 -->
                        <option>-dontwarn org.cef.**</option>
                        <option>-dontwarn com.sun.jna.**</option>
                        <option>-dontwarn liquibase.**</option>
                        <option>-dontwarn org.sqlite.**</option>
                        <option>-dontwarn com.fasterxml.**</option>
                        <option>-dontwarn com.google.gson.**</option>
                        <option>-dontwarn</option>
                        <option>-ignorewarnings</option>

                        <!-- 保留注解和必要属性 - 关键：添加StackMapTable来避免VerifyError -->
                        <option>-keepattributes Exceptions,InnerClasses,Signature,*,Annotation*,EnclosingMethod,SourceFile,LineNumberTable,LocalVariableTable,LocalVariableTypeTable,StackMapTable</option>
                    </options>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>7.4.2</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- 3. Spring Boot 重新打包：把混淆后的代码 + 所有依赖打进可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>cn.laobayou.siyubao.DesktopApp</mainClass>
                    <classifier>boot</classifier>
                    <jvmArguments>-Dcom.oracle.usagetracker=false</jvmArguments>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- 4. 打包 exe：使用 Spring Boot 重新打包后的 【可执行混淆 jar】 -->
            <plugin>
                <groupId>com.akathist.maven.plugins.launch4j</groupId>
                <artifactId>launch4j-maven-plugin</artifactId>
                <version>2.3.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>launch4j</goal>
                        </goals>
                        <configuration>
                            <headerType>console</headerType>
                            <outfile>target/社交聊天截图生成.exe</outfile>
                            <icon>${project.build.directory}/app.ico</icon>
                            <chdir>.</chdir>
                            <dontWrapJar>false</dontWrapJar>
                            <stayAlive>true</stayAlive>

                            <!-- 关键：使用 Spring Boot 重新打包后的可执行 jar -->
                            <jar>${project.build.directory}/${project.build.finalName}-boot.jar</jar>
                            <jre>
                                <minVersion>21</minVersion>
                                <path>rt/erj21</path>
                                <opts>
                                    <opt>-DSIYUBAO_ADMIN_BASE_URL=https://p.wzwlkj.cyou/</opt>
                                    <opt>-Dspring.config.location=file:./assets/images/test.yml</opt>
                                    <opt>-noverify</opt>
                                </opts>
                            </jre>
                            <classPath>
                                <mainClass>org.springframework.boot.loader.JarLauncher</mainClass>
<!--                                <jvmOptions>-->
<!--                                    <jvmOption>-noverify</jvmOption>-->
<!--                                </jvmOptions>-->
                            </classPath>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 下面所有插件保持你原来的不变 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>generate-exe-icon</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>cn.laobayou.siyubao.tools.ExeIconGenerator</mainClass>
                            <arguments>
                                <argument>${project.build.directory}/app.ico</argument>
                            </arguments>
                            <classpathScope>compile</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 复制JCEF本地库文件到输出目录 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>copy-jcef-resources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/jcef</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../external/jcef</directory>
                                    <includes>
                                        <include>**/*</include>
                                    </includes>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-single-file-package-testyml</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/../external/assets/images</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../external/config/user-app</directory>
                                    <includes>
                                        <include>test.yml</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-assets-resources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/assets</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../external/assets</directory>
                                    <includes>
                                        <include>**/*</include>
                                    </includes>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-bundled-jre</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/rt</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../external/rt</directory>
                                    <includes>
                                        <include>**/*</include>
                                    </includes>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-single-file-package</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../external</directory>
                                    <includes>
                                        <include>.test1</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-single-file-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../external</directory>
                                    <includes>
                                        <include>.test1</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-jcef-resources-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/jcef</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../external/jcef</directory>
                                    <includes>
