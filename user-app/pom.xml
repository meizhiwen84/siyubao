                    </execution>
                    <execution>
                        <id>copy-single-file-compile-testyml</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/../external/assets/images</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../external/config/user-app</directory>
                                    <includes>
                                        <include>test.yml</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-assets-resources-compile</id>
                        <phase>compile</phase>
